{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @xgamefi/db prisma generate"
  },
  "deploy": {
    "startCommand": "pnpm --filter @xgamefi/worker start",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1
  }
}
