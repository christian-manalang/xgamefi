{
  "name": "xgamefi",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "db:seed": "pnpm --filter @xgamefi/db db:seed",
    "db:generate": "pnpm --filter @xgamefi/db db:generate",
    "db:migrate": "pnpm --filter @xgamefi/db db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "dotenv": "^16.4.0"
  }
}
